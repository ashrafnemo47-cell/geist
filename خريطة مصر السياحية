          places: ["رأس البر", "دمياط الجديدة", "لسان رأس البر"],
        },
        {
          name: "الشرقية",
          lat: 30.5877,
          lng: 31.502,
          description: "تضم مواقع أثرية وتاريخية في شرق الدلتا.",
          places: ["تل بسطة", "صان الحجر"],
        },
        {
          name: "بورسعيد",
          lat: 31.2653,
          lng: 32.3019,
          description: "مدينة ساحلية عند المدخل الشمالي لقناة السويس.",
          places: ["شاطئ بورسعيد", "متحف بورسعيد", "قناة السويس"],
        },
        {
          name: "الإسماعيلية",
          lat: 30.5965,
          lng: 32.2715,
          description: "مدينة على قناة السويس وتضم بحيرات ومناطق طبيعية.",
          places: ["بحيرة التمساح", "حدائق الملاحة", "قناة السويس"],
        },
        {
          name: "السويس",
          lat: 29.9668,
          lng: 32.5498,
          description: "محافظة ساحلية عند المدخل الجنوبي لقناة السويس.",
          places: ["العين السخنة", "شاطئ السويس", "جبل عتاقة"],
        },
        {
          name: "شمال سيناء",
          lat: 30.5965,
          lng: 32.2715,
          description: "تضم مناطق ساحلية وطبيعية في شمال شبه جزيرة سيناء.",
          places: ["العريش", "بحيرة البردويل", "رفح"],
        },
        {
          name: "جنوب سيناء",
          lat: 28.438,
          lng: 33.625,
          description: "وجهة سياحية مشهورة بالشواطئ والغوص والجبال.",
          places: ["شرم الشيخ", "دهب", "نويبع", "طابا", "سانت كاترين"],
        },
        {
          name: "البحر الأحمر",
          lat: 27.2579,
          lng: 33.8116,
          description: "من أهم مناطق السياحة البحرية والغوص والشواطئ في مصر.",
          places: [
            "الغردقة",
            "الجونة",
            "سفاجا",
            "القصير",
            "مرسى علم",
            "رأس غارب",
          ],
        },
        {
          name: "مطروح",
          lat: 31.3543,
          lng: 27.2373,
          description: "محافظة ساحلية تضم شواطئ البحر المتوسط وواحة سيوة.",
          places: [
            "مرسى مطروح",
            "العلمين",
            "سيوة",
            "السلوم",
            "سيدي عبد الرحمن",
          ],
        },
        {
          name: "الفيوم",
          lat: 29.3084,
          lng: 30.8428,
          description: "تشتهر بالبحيرات والشلالات والمحميات الطبيعية.",
          places: ["بحيرة قارون", "وادي الريان", "وادي الحيتان", "قرية تونس"],
        },
        {
          name: "بني سويف",
          lat: 29.0661,
          lng: 31.0994,
          description: "محافظة في شمال صعيد مصر.",
          places: ["هرم ميدوم", "مناطق النيل"],
        },
        {
          name: "المنيا",
          lat: 28.1099,
          lng: 30.7503,
          description: "تضم مواقع أثرية مهمة من عصور مصر القديمة.",
          places: ["تل العمارنة", "بني حسن", "تونا الجبل"],
        },
        {
          name: "أسيوط",
          lat: 27.1783,
          lng: 31.1859,
          description: "محافظة تاريخية في صعيد مصر.",
          places: ["دير المحرق", "منطقة القوصية"],
        },
        {
          name: "سوهاج",
          lat: 26.5591,
          lng: 31.6957,
          description: "تضم معالم أثرية وقبطية وتاريخية.",
          places: ["أبيدوس", "أخميم", "الدير الأبيض"],
        },
        {
          name: "قنا",
          lat: 26.1551,
          lng: 32.716,
          description: "تضم معابد ومواقع أثرية مهمة في صعيد مصر.",
          places: ["معبد دندرة", "قوص", "نقادة"],
        },
        {
          name: "الأقصر",
          lat: 25.6872,
          lng: 32.6396,
          description: "متحف مفتوح يضم معابد ومقابر أثرية عالمية.",
          places: [
            "معبد الكرنك",
            "معبد الأقصر",
            "وادي الملوك",
            "معبد حتشبسوت",
            "البر الغربي",
          ],
        },
        {
          name: "أسوان",
          lat: 24.0889,
          lng: 32.8998,
          description:
            "وجهة سياحية على النيل تشتهر بالمعابد والجزر والطبيعة النوبية.",
          places: [
            "معبد فيلة",
            "السد العالي",
            "جزيرة النباتات",
            "معبد أبو سمبل",
            "القرية النوبية",
          ],
        },
        {
          name: "الوادي الجديد",
          lat: 25.439,
          lng: 30.5586,
          description: "تضم الواحات والصحاري والمواقع الأثرية.",
          places: [
            "واحة الخارجة",
            "واحة الداخلة",
            "واحة الفرافرة",
            "الصحراء البيضاء",
          ],
        },
        {
          name: "الجيزة",
          lat: 29.987,
          lng: 31.2118,
          description: "محافظة تضم مناطق أثرية شهيرة.",
          places: ["الأهرامات", "سقارة", "دهشور"],
        },
      ];

      // منع تكرار الجيزة وإضافة محافظة الأقصر وأسوان بشكل مستقل.
      const uniqueGovernorates = [
        ...new Map(governorates.map((g) => [g.name, g])).values(),
      ];

      const map = L.map("map", {
        center: [27.5, 30.8],
        zoom: 5,
        minZoom: 4,
        maxZoom: 15,
        scrollWheelZoom: true,
      });

      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution:
          '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(map);

      const markers = new Map();

      const goldIcon = L.divIcon({
        className: "",
        html: `
    <div style="
      width:23px;height:23px;
      background:#e9bd60;
      border:3px solid white;
      border-radius:50%;
      box-shadow:0 0 15px #e9bd60;
    "></div>
  `,
        iconSize: [23, 23],
        iconAnchor: [11, 11],
      });

      const list = document.getElementById("governorates");

      function openGovernorate(gov) {
        document.getElementById("govName").textContent = gov.name;
        document.getElementById("govDescription").textContent = gov.description;

        const places = document.getElementById("places");
        places.innerHTML = "";

        gov.places.forEach((place) => {
          const card = document.createElement("article");
          card.className = "place";

          const title = document.createElement("h3");
          title.textContent = place;

          const description = document.createElement("p");
          description.textContent =
            "استكشف موقع هذا المكان السياحي على الخريطة.";

          const link = document.createElement("a");
          link.className = "gps";
          link.target = "_blank";
          link.rel = "noopener";
          link.href =
            "https://www.google.com/maps/search/?api=1&query=" +
            encodeURIComponent(place + " " + gov.name + " Egypt");
          link.textContent = "افتح الموقع GPS";

          card.append(title, description, link);
          places.appendChild(card);
        });

        document.getElementById("details").classList.add("show");

        document.querySelectorAll(".gov-btn").forEach((btn) => {
          btn.classList.toggle("active", btn.dataset.name === gov.name);
        });

        const marker = markers.get(gov.name);
        if (marker) {
          map.flyTo(marker.getLatLng(), 8, { duration: 1.2 });
          marker.openPopup();
        }

        document.getElementById("details").scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
      }

      uniqueGovernorates.forEach((gov) => {
        const marker = L.marker([gov.lat, gov.lng], {
          icon: goldIcon,
        }).addTo(map);

        marker.bindPopup(`<b>${gov.name}</b><br>اضغط لاكتشاف المحافظة`);

        marker.on("click", () => openGovernorate(gov));
        markers.set(gov.name, marker);

        const button = document.createElement("button");
        button.className = "gov-btn";
        button.textContent = "📍 " + gov.name;
        button.dataset.name = gov.name;
        button.addEventListener("click", () => openGovernorate(gov));

        list.appendChild(button);
      });

      document.getElementById("search").addEventListener("input", function () {
        const value = this.value.trim();

        document.querySelectorAll(".gov-btn").forEach((button) => {
          button.style.display = button.dataset.name.includes(value)
            ? "block"
            : "none";
        });
      });
    </script>
  </body>
</html>
